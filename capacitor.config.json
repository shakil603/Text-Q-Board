{
  "appId": "com.textqboard.app",
  "appName": "Text Q Board",
  "webDir": "dist",
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#111318"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#111318",
      "showSpinner": false,
      "androidScaleType": "CENTER_INSIDE",
      "splashFullScreen": false,
      "splashImmersive": false
    }
  }
}
